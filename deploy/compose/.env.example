# Non-secret configuration only. All secrets are read from Vault at runtime.
COMPOSE_PROJECT_NAME=gov

API_PORT=8000
GATEWAY_PORT=9000
WEB_PORT=5173
OPA_PORT=8181
VAULT_PORT=8200
KEYCLOAK_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_DB=gov
POSTGRES_USER=gov_app

OIDC_ISSUER=http://keycloak:8080/realms/gov
OIDC_AUDIENCE=gov-api
OIDC_JWKS_URL=http://keycloak:8080/realms/gov/protocol/openid-connect/certs

OPA_URL=http://opa:8181
VAULT_ADDR=http://vault:8200
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
